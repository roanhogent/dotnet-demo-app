pipeline {
    agent any 

    environment {
        DOTNET_CLI_TELEMETRY_OPTOUT = '1'
        DOCKER_HOST                 = 'unix:///var/run/docker.sock'
    }

    stages {
        
        stage('Build Project') {
            steps {
                sh "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v bld-cache:/root/.nuget/packages -v ${WORKSPACE}:/app -w /app ://microsoft.com dotnet restore"
                sh "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v bld-cache:/root/.nuget/packages -v ${WORKSPACE}:/app -w /app ://microsoft.com dotnet build --configuration Release --no-restore"
            }
        }

        // STAP 
        stage('Run Integration Tests') {
            steps {
                sh "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v bld-cache:/root/.nuget/packages -v ${WORKSPACE}:/app -w /app ://microsoft.com dotnet test --configuration Release --no-build --logger 'trx;LogFileName=test_results.trx'"
            }
            post {
                always {
                    
                    mstest testResultsFile: '**/*.trx', keepLongStdio: true
                }
            }
        }
    }
}
